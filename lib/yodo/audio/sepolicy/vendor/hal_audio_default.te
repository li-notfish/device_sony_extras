r_dir_file(hal_audio_default, threesixtyra_vendor_data_file)

allow hal_audio_default hal_dms_hwservice:hwservice_manager find;
allow hal_audio_default vendor_hal_secd_hwservice:hwservice_manager { find };

hal_client_domain(hal_audio_default, hal_dms)

allow hal_audio_default gpu_device:chr_file rw_file_perms;

allow hal_audio_default vendor_hal_secd_default:binder { call };
allow hal_audio_default vendor_tee_listener_prop:file { read open getattr map };
allow hal_audio_default vendor_camera_running_status_prop:file { read open getattr map };
allow hal_audio_default vendor_camera_sensor_prop:file { read open getattr map };

allow hal_audio_default vendor_360ra_prop:file {read getattr map open};
allow hal_audio_default vendor_spatializer_prop:file {read getattr map open};
allow hal_audio_default vendor_360ra_restricted_prop:file {read getattr map open};
set_prop(hal_audio_default,vendor_spatializer_prop)
set_prop(hal_audio_default,vendor_360ra_restricted_prop)
set_prop(hal_audio_default,vendor_360ra_prop)